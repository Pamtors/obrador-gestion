# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env a GitHub.

# Clave secreta para firmar las sesiones de usuario.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga

# URL de conexion a la base de datos.
# Desarrollo local (SQLite, no requiere instalar nada):
DATABASE_URL=sqlite:///./obrador.db
# Produccion (PostgreSQL en la nube, descomentar cuando toque):
# DATABASE_URL=postgresql://usuario:contrasena@host:5432/obrador

# Entorno: development | production
ENTORNO=development

# Datos del primer usuario ADMIN (solo los usa scripts/seed.py la primera vez)
ADMIN_NOMBRE=Admin
ADMIN_EMAIL=admin@obrador-demo.example
ADMIN_PASSWORD=cambia_esto_tambien

# Contraseña del usuario invitado (solo lectura). Si lo dejas vacío, no se crea.
INVITADO_PASSWORD=
